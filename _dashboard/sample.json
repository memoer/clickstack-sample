{
  "version": "0.1.0",
  "name": "ClickStack Monitoring Dashboard",
  "tiles": [
    {
      "id": "http-rpm",
      "x": 0,
      "y": 0,
      "w": 6,
      "h": 10,
      "config": {
        "name": "HTTP Requests Per Minute",
        "source": "Metrics",
        "displayType": "line",
        "granularity": "1 minute",
        "markdown": "",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "Value",
            "alias": "requests",
            "metricType": "sum",
            "metricName": "http.requests.total"
          }
        ],
        "where": "",
        "whereLanguage": "lucene",
        "groupBy": "Attributes['route']"
      }
    },
    {
      "id": "http-errors",
      "x": 6,
      "y": 0,
      "w": 6,
      "h": 10,
      "config": {
        "name": "HTTP Errors Per Minute",
