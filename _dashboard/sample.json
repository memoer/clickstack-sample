    {
      "id": "mongodb-latency",
      "x": 0,
      "y": 20,
      "w": 8,
      "h": 10,
      "config": {
        "name": "MongoDB Slow Operations (>1000ms)",
        "source": "Traces",
        "displayType": "table",
        "granularity": "1 minute",
        "markdown": "",
        "select": [
          {
            "aggFn": "avg",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "Duration/1000000",
            "alias": "avg_latency_ms"
          },
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "",
            "alias": "count"
          }
        ],
        "where": "SpanAttributes['db.system'] = 'mongodb' AND Duration > 1000000000",
        "whereLanguage": "sql",
        "groupBy": "SpanAttributes['db.operation']",
        "sortOrder": "desc"
      }
    },
