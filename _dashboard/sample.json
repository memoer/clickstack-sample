        "markdown": "",
        "select": [
          {
            "aggFn": "p95",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "Value * 1000",
            "alias": "p95_latency_ms",
            "metricType": "histogram",
            "metricName": "http.server.request.duration"
          }
        ],
        "where": "",
        "whereLanguage": "lucene",
        "groupBy": "Attributes['http.route']"
      }
    },
