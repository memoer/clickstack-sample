        ],
        "where": "Attributes['status'] = 'success'",
        "whereLanguage": "sql",
        "groupBy": "Attributes['route']"
      }
    },
    {
      "id": "http-p95",
      "x": 18,
      "y": 0,
      "w": 6,
      "h": 10,
      "config": {
        "name": "HTTP P95 Latency (ms)",
