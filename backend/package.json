{
  "name": "clickstack-demo-backend",
  "version": "1.0.0",
  "description": "NestJS backend with OpenTelemetry (Vendor-neutral) + Pino logging",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:watch": "NODE_ENV=dev nest start --watch",
    "start:dev": "NODE_ENV=dev node dist/main",
    "start:prod": "NODE_ENV=prod node dist/main"
  },
  "dependencies": {
    "@nestjs/common": "11.1.11",
    "@nestjs/core": "11.1.11",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.1.11",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.209.0",
    "@opentelemetry/auto-instrumentations-node": "0.67.3",
    "@opentelemetry/exporter-logs-otlp-http": "0.209.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.209.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.209.0",
    "@opentelemetry/instrumentation-http": "0.209.0",
    "@opentelemetry/instrumentation-pino": "0.55.1",
    "@opentelemetry/instrumentation-runtime-node": "0.22.0",
    "@opentelemetry/resources": "2.3.0",
    "@opentelemetry/sdk-logs": "0.209.0",
    "@opentelemetry/sdk-metrics": "2.3.0",
    "@opentelemetry/sdk-node": "0.209.0",
    "@opentelemetry/sdk-trace-node": "2.3.0",
    "@opentelemetry/semantic-conventions": "1.38.0",
    "@prisma/client": "6.19.1",
    "@prisma/instrumentation": "7.2.0",
    "dotenv": "17.2.3",
    "ioredis": "5.9.1",
    "mongoose": "9.1.3",
    "pg": "8.16.3",
    "pino": "10.1.1",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.14",
    "@types/express": "5.0.6",
    "@types/node": "25.0.6",
    "prisma": "^6.14.0",
    "typescript": "5.9.3"
  }
}
